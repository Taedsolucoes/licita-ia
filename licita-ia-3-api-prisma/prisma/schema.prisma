generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANTS
// ============================================
model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  corporateName String   @map("corporate_name")
  tradeName     String   @map("trade_name")
  cnpj          String   @unique @db.VarChar(18)
  status        String   @default("active") @db.VarChar(20)
  contactName   String   @map("contact_name")
  contactEmail  String   @map("contact_email")
  contactPhone  String   @map("contact_phone")
  whatsappNumber String? @map("whatsapp_number")
  planType      String   @default("basic") @map("plan_type") @db.VarChar(30)
  lgpdConsentAt DateTime? @map("lgpd_consent_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users                  User[]
  companyKeywords        CompanyKeyword[]
  companyRegions         CompanyRegion[]
  opportunities          Opportunity[]
  participations         Participation[]
  reports                Report[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs              AuditLog[]

  @@map("tenants")
}

// ============================================
// USERS
// ============================================
model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  role         String    @db.VarChar(20)
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  devices              Device[]
  notifications        Notification[]
  reportDownloads      ReportDownload[]
  participationsAccepted Participation[]    @relation("AcceptedBy")
  notificationPreferences NotificationPreference[]
  refreshTokens        RefreshToken[]

  @@index([tenantId])
  @@map("users")
}

// ============================================
// REFRESH TOKENS
// ============================================
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  replacedByTokenHash String? @map("replaced_by_token_hash")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================
// DEVICES
// ============================================
model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String   @db.VarChar(10)
  fcmToken   String   @map("fcm_token")
  appVersion String?  @map("app_version")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("devices")
}

// ============================================
// COMPANY KEYWORDS
// ============================================
model CompanyKeyword {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  keyword           String
  normalizedKeyword String   @map("normalized_keyword")
  matchType         String   @default("include") @map("match_type") @db.VarChar(10)
  weight            Float    @default(1.0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, normalizedKeyword])
  @@map("company_keywords")
}

// ============================================
// COMPANY REGIONS
// ============================================
model CompanyRegion {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  uf                  String   @db.VarChar(2)
  municipalityName    String?  @map("municipality_name")
  municipalityIbgeCode String? @map("municipality_ibge_code") @db.VarChar(7)
  scopeType           String   @map("scope_type") @db.VarChar(15)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, uf, municipalityIbgeCode])
  @@map("company_regions")
}

// ============================================
// BIDDINGS
// ============================================
model Bidding {
  id                  String    @id @default(uuid()) @db.Uuid
  source              String    @db.VarChar(30)
  sourceExternalId    String    @map("source_external_id")
  sourceUrl           String?   @map("source_url")
  biddingNumber       String?   @map("bidding_number")
  modality            String?
  uasg                String?
  sphere              String?
  agencyName          String?   @map("agency_name")
  agencyDocument      String?   @map("agency_document")
  objectText          String    @map("object_text")
  objectSummary       String?   @map("object_summary")
  publicationDate     DateTime? @map("publication_date")
  openingDate         DateTime? @map("opening_date")
  proposalDueDate     DateTime? @map("proposal_due_date")
  estimatedValue      Decimal?  @map("estimated_value") @db.Decimal(18, 2)
  municipalityName    String?   @map("municipality_name")
  municipalityIbgeCode String?  @map("municipality_ibge_code") @db.VarChar(7)
  uf                  String?   @db.VarChar(2)
  status              String    @default("open") @db.VarChar(20)
  riskLevel           String?   @map("risk_level") @db.VarChar(10)
  rawPayload          Json?     @map("raw_payload")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  items               BiddingItem[]
  documents           BiddingDocument[]
  opportunities       Opportunity[]
  reports             Report[]

  @@unique([source, sourceExternalId])
  @@index([status, proposalDueDate])
  @@index([municipalityIbgeCode, uf])
  @@map("biddings")
}

// ============================================
// BIDDING ITEMS
// ============================================
model BiddingItem {
  id                  String   @id @default(uuid()) @db.Uuid
  biddingId           String   @map("bidding_id") @db.Uuid
  itemNumber          Int      @map("item_number")
  description         String
  quantity            Decimal  @db.Decimal(18, 4)
  unit                String   @db.VarChar(20)
  unitValueEstimated  Decimal? @map("unit_value_estimated") @db.Decimal(18, 2)
  totalValueEstimated Decimal? @map("total_value_estimated") @db.Decimal(18, 2)
  catalogCode         String?  @map("catalog_code")
  rawPayload          Json?    @map("raw_payload")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  bidding             Bidding  @relation(fields: [biddingId], references: [id])
  opportunityItems    OpportunityItem[]
  participationItems  ParticipationItem[]

  @@index([biddingId])
  @@map("bidding_items")
}

// ============================================
// BIDDING DOCUMENTS
// ============================================
model BiddingDocument {
  id           String   @id @default(uuid()) @db.Uuid
  biddingId    String   @map("bidding_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(50)
  fileName     String   @map("file_name")
  sourceUrl    String?  @map("source_url")
  checksum     String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bidding Bidding @relation(fields: [biddingId], references: [id])

  @@index([biddingId])
  @@map("bidding_documents")
}

// ============================================
// CAPAG RECORDS
// ============================================
model CapagRecord {
  id                   String    @id @default(uuid()) @db.Uuid
  municipalityIbgeCode String    @unique @map("municipality_ibge_code") @db.VarChar(7)
  municipalityName     String    @map("municipality_name")
  uf                   String    @db.VarChar(2)
  capagRating          String    @map("capag_rating") @db.VarChar(2)
  explanationShort     String?   @map("explanation_short")
  referenceYear        Int       @map("reference_year")
  sourceReference      String?   @map("source_reference")
  rawPayload           Json?     @map("raw_payload")
  updatedFromSourceAt  DateTime? @map("updated_from_source_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("capag_records")
}

// ============================================
// CAPAG HISTORY
// ============================================
model CapagHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  municipalityIbgeCode String   @map("municipality_ibge_code") @db.VarChar(7)
  capagRating          String   @map("capag_rating") @db.VarChar(2)
  explanationShort     String?  @map("explanation_short")
  referenceYear        Int      @map("reference_year")
  rawPayload           Json?    @map("raw_payload")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([municipalityIbgeCode, referenceYear])
  @@map("capag_history")
}

// ============================================
// OPPORTUNITIES
// ============================================
model Opportunity {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  biddingId           String    @map("bidding_id") @db.Uuid
  matchingScore       Float     @map("matching_score")
  matchedKeywords     Json?     @map("matched_keywords")
  matchedRegionType   String?   @map("matched_region_type") @db.VarChar(15)
  capagRatingSnapshot String?   @map("capag_rating_snapshot") @db.VarChar(2)
  status              String    @default("new") @db.VarChar(20)
  analysisCompletedAt DateTime? @map("analysis_completed_at")
  firstNotifiedAt     DateTime? @map("first_notified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  bidding      Bidding         @relation(fields: [biddingId], references: [id])
  items        OpportunityItem[]
  participation Participation?
  reports      Report[]
  notifications Notification[]

  @@index([tenantId, status, createdAt])
  @@map("opportunities")
}

// ============================================
// OPPORTUNITY ITEMS
// ============================================
model OpportunityItem {
  id                    String   @id @default(uuid()) @db.Uuid
  opportunityId         String   @map("opportunity_id") @db.Uuid
  biddingItemId         String   @map("bidding_item_id") @db.Uuid
  suggestedBrand        String?  @map("suggested_brand")
  estimatedMarginPercent Decimal? @map("estimated_margin_percent") @db.Decimal(5, 2)
  customerBrand         String?  @map("customer_brand")
  customerUnitPrice     Decimal? @map("customer_unit_price") @db.Decimal(18, 2)
  customerTotalPrice    Decimal? @map("customer_total_price") @db.Decimal(18, 2)
  customerNotes         String?  @map("customer_notes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  biddingItem BiddingItem @relation(fields: [biddingItemId], references: [id])

  @@index([opportunityId])
  @@map("opportunity_items")
}

// ============================================
// PARTICIPATIONS
// ============================================
model Participation {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  opportunityId         String    @unique @map("opportunity_id") @db.Uuid
  acceptedByUserId      String    @map("accepted_by_user_id") @db.Uuid
  status                String    @default("draft") @db.VarChar(30)
  consolidatedTotalValue Decimal? @map("consolidated_total_value") @db.Decimal(18, 2)
  submittedAt           DateTime? @map("submitted_at")
  taedNotifiedAt        DateTime? @map("taed_notified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  opportunity  Opportunity     @relation(fields: [opportunityId], references: [id])
  acceptedBy   User            @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  items        ParticipationItem[]

  @@index([tenantId, status, submittedAt])
  @@map("participations")
}

// ============================================
// PARTICIPATION ITEMS
// ============================================
model ParticipationItem {
  id              String   @id @default(uuid()) @db.Uuid
  participationId String   @map("participation_id") @db.Uuid
  biddingItemId   String   @map("bidding_item_id") @db.Uuid
  brand           String
  finalUnitPrice  Decimal  @map("final_unit_price") @db.Decimal(18, 2)
  quantity        Decimal  @db.Decimal(18, 4)
  finalTotalPrice Decimal  @map("final_total_price") @db.Decimal(18, 2)
  marginValue     Decimal? @map("margin_value") @db.Decimal(18, 2)
  marginPercent   Decimal? @map("margin_percent") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  participation Participation @relation(fields: [participationId], references: [id])
  biddingItem   BiddingItem   @relation(fields: [biddingItemId], references: [id])

  @@index([participationId])
  @@map("participation_items")
}

// ============================================
// REPORTS
// ============================================
model Report {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  biddingId       String    @map("bidding_id") @db.Uuid
  opportunityId   String?   @map("opportunity_id") @db.Uuid
  reportType      String    @default("bidding_analysis") @map("report_type") @db.VarChar(30)
  status          String    @default("queued") @db.VarChar(20)
  storageKey      String?   @map("storage_key")
  fileName        String?   @map("file_name")
  checksum        String?
  generatedAt     DateTime? @map("generated_at")
  expiresAt       DateTime? @map("expires_at")
  createdBySystem Boolean   @default(true) @map("created_by_system")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  bidding     Bidding      @relation(fields: [biddingId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  downloads   ReportDownload[]

  @@index([tenantId])
  @@map("reports")
}

// ============================================
// REPORT DOWNLOADS
// ============================================
model ReportDownload {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent")

  report Report @relation(fields: [reportId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([reportId])
  @@map("report_downloads")
}

// ============================================
// NOTIFICATIONS
// ============================================
model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  opportunityId     String?   @map("opportunity_id") @db.Uuid
  channel           String    @db.VarChar(10)
  templateCode      String    @map("template_code") @db.VarChar(50)
  payload           Json?
  providerMessageId String?   @map("provider_message_id")
  status            String    @default("queued") @db.VarChar(15)
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  failedReason      String?   @map("failed_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([tenantId, channel, status])
  @@map("notifications")
}

// ============================================
// NOTIFICATION PREFERENCES
// ============================================
model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  allowPush       Boolean  @default(true) @map("allow_push")
  allowWhatsapp   Boolean  @default(true) @map("allow_whatsapp")
  quietHoursStart String?  @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd   String?  @map("quiet_hours_end") @db.VarChar(5)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("notification_preferences")
}

// ============================================
// INTEGRATION SYNC RUNS
// ============================================
model IntegrationSyncRun {
  id              String    @id @default(uuid()) @db.Uuid
  integrationName String    @map("integration_name") @db.VarChar(50)
  runType         String    @map("run_type") @db.VarChar(30)
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  status          String    @db.VarChar(20)
  cursorReference String?   @map("cursor_reference")
  recordsRead     Int       @default(0) @map("records_read")
  recordsCreated  Int       @default(0) @map("records_created")
  recordsUpdated  Int       @default(0) @map("records_updated")
  errorSummary    String?   @map("error_summary")

  @@index([integrationName, startedAt])
  @@map("integration_sync_runs")
}

// ============================================
// AUDIT LOGS
// ============================================
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(50)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
