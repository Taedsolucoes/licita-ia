{
  "name": "licita-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Licita IA - SaaS de gestão de licitações públicas",
  "scripts": {
    "dev": "pnpm --filter @licita-ia/api dev",
    "build": "pnpm --filter @licita-ia/api build",
    "start": "pnpm --filter @licita-ia/api start:prod",
    "db:migrate": "pnpm --filter @licita-ia/api db:migrate",
    "db:seed": "pnpm --filter @licita-ia/api db:seed",
    "db:generate": "pnpm --filter @licita-ia/api db:generate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "expo-tunnel": "cd apps/mobile-client && npx expo start --tunnel"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
