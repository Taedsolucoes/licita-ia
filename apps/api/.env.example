# ============================================================
# Public procurement source synchronization
# ============================================================

# Disabled by default. Enable only after an official-source adapter
# (PNCP/Compras.gov.br) is registered and approved.
PUBLIC_SOURCES_SYNC_ENABLED=false

# Auto-sync interval in milliseconds (default: 1800000 = 30 minutes)
# SYNC_INTERVAL_MS=1800000

# ============================================================
# WhatsApp Business Cloud API (Meta)
# ============================================================
# When set, real WhatsApp messages are sent via the Meta API.
# When not set, the service falls back to log-only (mock mode).

# Permanent or temporary access token from Meta Business Dashboard
WHATSAPP_TOKEN=

# Phone Number ID from the WhatsApp Business App in Meta Developer Console
WHATSAPP_PHONE_NUMBER_ID=

# Approved template names in Meta Business Manager (pt_BR locale)
# Defaults shown — override only if you registered different template names.
# Template body: "Nova oportunidade! Orgao: {{1}}, Objeto: {{2}}, Valor: {{3}}. Acesse o app para detalhes."
WHATSAPP_TEMPLATE_OPPORTUNITY=opportunity_alert

# Template body: "Proposta enviada! Licitacao: {{1}}, Valor total: {{2}}."
WHATSAPP_TEMPLATE_PARTICIPATION=participation_confirmation

# ============================================================
# Firebase Cloud Messaging (FCM) — Push Notifications
# ============================================================
# When set, real push notifications are sent via Firebase Admin SDK.
# When not set, the service falls back to log-only (mock mode).

# Base64-encoded (or raw JSON) Firebase service account key.
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then base64-encode it: base64 -w 0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================================
# SMTP — Password reset e-mails (nodemailer)
# ============================================================
# When SMTP_HOST is not set, MailService runs in mock mode (emails are logged).
SMTP_HOST=
SMTP_PORT=587
# true|false — defaults to true when port is 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@licitaia.com.br

# Base web URL used to build the password reset link sent by e-mail
APP_WEB_URL=

# ============================================================
# CORS
# ============================================================
# REQUIRED in production. Comma-separated list of allowed origins.
# Example: CORS_ORIGIN=https://app.licitaia.com.br,https://admin.licitaia.com.br
CORS_ORIGIN=
