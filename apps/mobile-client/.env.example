# URL base da API NestJS (Expo Web/Mobile)
EXPO_PUBLIC_API_URL=https://seu-host-publico/api

# ID do projeto EAS usado por expo-notifications para emitir Expo Push Tokens.
# Opcional se o build já obtiver um token FCM/APNs nativo e o backend estiver configurado.
EXPO_PUBLIC_EAS_PROJECT_ID=seu-eas-project-id
